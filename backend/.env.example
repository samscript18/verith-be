# Runtime and deployment-specific addresses
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
LOG_LEVEL=debug
SWAGGER_ENABLED=true
PROCESS_ROLE=all

# Local defaults work without these overrides.
MONGODB_URI=mongodb://localhost:27017/verith
REDIS_URL=redis://localhost:6379

# Required secrets: generate unique values of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
HASHING_PEPPER=replace-with-at-least-32-random-characters
DATA_EXPORT_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Cookie deployment policy
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Optional media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP delivery
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=

# Optional no-cost AI tiers. Verith falls through configured providers.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=

# Optional WhatsApp integration
WHATSAPP_ENABLED=false
MASTER_ENCRYPTION_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_REPORT_DEEP_LINK_BASE=
