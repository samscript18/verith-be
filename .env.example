# Runtime and deployment-specific addresses
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
LOG_LEVEL=debug
SWAGGER_ENABLED=true
PROCESS_ROLE=all
# Use `memory` for one API instance (including PROCESS_ROLE=all) to reserve
# Redis commands for BullMQ. Set `redis` only when several API instances serve
# traffic and rate limits must be shared between them.
THROTTLER_STORAGE=memory
API_REPLICA_COUNT=1

# Local defaults work without these overrides.
MONGODB_URI=mongodb://localhost:27017/verith
REDIS_URL=redis://localhost:6379

# Required secrets: generate unique values of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
HASHING_PEPPER=replace-with-at-least-32-random-characters
DATA_EXPORT_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# One-time production bootstrap. The password is required only when the
# super-admin does not already exist and can be removed after the first deploy.
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# Optional Google Identity Services web client ID.
GOOGLE_CLIENT_ID=

# Cookie deployment policy
# For a Vercel frontend using its built-in API rewrite, leave COOKIE_DOMAIN
# empty, use secure cookies in production, and keep SameSite=Lax.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Optional media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP delivery
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=

# Optional no-cost AI tiers. Verith falls through configured providers.
GEMINI_API_KEY=
# Comma-separated, legitimately issued keys. Plural values take precedence.
# Up to three legitimately issued keys, comma-separated. The singular key
# remains supported for one-key deployments.
GEMINI_API_KEYS=
GROQ_API_KEY=
GROQ_API_KEYS=
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_SITE_URL=

# Optional funded reliability providers. Keep disabled until the account,
# region, model access, quotas, and a staging investigation have been verified.
VERTEX_AI_ENABLED=false
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# Prefer Application Default Credentials on Google Cloud. For hosts such as
# Render, this may contain one secret-managed service-account JSON object.
GOOGLE_CLOUD_CREDENTIALS_JSON=
VERTEX_MODEL_TEXT=gemini-2.5-flash
VERTEX_MODEL_REASONING=gemini-2.5-flash
VERTEX_MODEL_LOCALIZATION=gemini-2.5-flash
VERTEX_MODEL_VISION=gemini-2.5-flash
VERTEX_MODEL_VIDEO=gemini-2.5-flash

BEDROCK_ENABLED=false
BEDROCK_REGION=us-east-1
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and optional AWS_SESSION_TOKEN use
# the standard AWS SDK credential chain. Prefer an IAM role where available.
BEDROCK_MODEL_TEXT=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_REASONING=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_LOCALIZATION=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Per-process concurrency. BullMQ continues to queue complete investigations;
# these gates limit provider work inside each worker process.
AI_TEXT_CONCURRENCY=5
AI_REPORT_CONCURRENCY=2
AI_LOCALIZATION_CONCURRENCY=2
AI_MEDIA_CONCURRENCY=2
AI_AUDIO_CONCURRENCY=2
AI_VIDEO_CONCURRENCY=1
VERTEX_TEXT_CONCURRENCY=4
VERTEX_MEDIA_CONCURRENCY=2
BEDROCK_TEXT_CONCURRENCY=2
GROQ_CONCURRENCY=4
GEMINI_DIRECT_CONCURRENCY=2

# Review-period cost guard. Pricing is deliberately configuration-owned
# because model prices change. Keys are PROVIDER:model (or PROVIDER:*), values
# contain inputUsdPerMillion and outputUsdPerMillion. Enabling the guard without
# a pricing object fails startup rather than pretending that zero cost is real.
AI_COST_GUARD_ENABLED=false
AI_REVIEW_PERIOD_START=2026-08-01T00:00:00.000Z
AI_REVIEW_BUDGET_USD=250
VERTEX_REVIEW_BUDGET_USD=220
BEDROCK_REVIEW_BUDGET_USD=30
AI_BUDGET_CONSERVE_PERCENT=70
AI_BUDGET_CRITICAL_PERCENT=85
AI_BUDGET_EXHAUSTED_PERCENT=95
AI_EXECUTION_RETENTION_DAYS=120
# Conservative Standard/US-geo estimates checked on 2026-08-13. Reconfirm the
# official pricing pages before enabling the guard because cloud prices change.
AI_MODEL_PRICING_JSON={"VERTEX:gemini-2.5-flash":{"inputUsdPerMillion":0.30,"outputUsdPerMillion":2.50},"BEDROCK:us.anthropic.claude-haiku-4-5-20251001-v1:0":{"inputUsdPerMillion":1.10,"outputUsdPerMillion":5.50}}
# Optional JSON capability-route overrides. Normal deployments should use the
# reviewed code defaults documented in docs/provider-routing.md.
AI_CAPABILITY_ROUTES_JSON=

# Optional primary evidence-search provider. Wikipedia remains the fallback.
TAVILY_API_KEY=
TAVILY_API_KEYS=
TAVILY_BASE_URL=https://api.tavily.com/search
